# The homeserver's server name: the part after ":" in user IDs.
SERVER_NAME=example.com
# Where the bridge reaches the homeserver's client-server API, and the
# Docker network on which it does so. The homeserver reaches the bridge on
# that network as http://beeper-line:29322.
HOMESERVER_URL=http://synapse:8008
HOMESERVER_NETWORK=synapse_default

# Who may use the bridge: a server name (all of its users) or one user ID.
BRIDGE_USERS=example.com
# A user ID with admin rights over the bridge.
BRIDGE_ADMIN=@admin:example.com

# Optional: a directory the homeserver reads registration files from.
# setup.sh copies the bridge's registration there as beeper-line.yaml.
#REGISTRATION_DIR=../koto/data/synapse/appservices

# Optional: a PostgreSQL URI instead of the default SQLite file in data/.
#DATABASE_URI=postgres://beeper_line:password@postgres/beeper_line?sslmode=disable

# The beeper/line commit the bridge runs. This repository's CI publishes an
# image for the commit below, tagged with it.
BEEPER_LINE_REF=72c7a51a44f344966b916bd2f42a734381061186
# Where that image is pulled from.
#BEEPER_LINE_IMAGE=ghcr.io/genji1024/beeper-line
# "source" builds the image here instead of pulling it. The build needs
# more than 10 GB of memory (swap included) and the Docker buildx plugin.
#BEEPER_LINE_BUILD=source
